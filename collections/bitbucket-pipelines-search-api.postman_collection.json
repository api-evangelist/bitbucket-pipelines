        {
          "id": "7eb266ba-7fae-4707-b534-05eba83b9f78",
          "name": "Search for code in a team's repositories",
          "request": {
            "name": "Search for code in a team's repositories",
            "description": {
              "content": "This API will be deprecated on November 1, 2026.\n\nSearch for code in the repositories of the specified team.\n\nNote that searches can match in the file's text (`content_matches`),\nthe path (`path_matches`), or both.\n\nYou can use the same syntax for the search query as in the UI.\nE.g. to search for \"foo\" only within the repository \"demo\",\nuse the query parameter `search_query=foo+repo:demo`.\n\nSimilar to other APIs, you can request more fields using a\n`fields` query parameter. E.g. to get some more information about\nthe repository of matched files, use the query parameter\n`search_query=foo&fields=%2Bvalues.file.commit.repository`\n(the `%2B` is a URL-encoded `+`).\n\nTry `fields=%2Bvalues.*.*.*.*` to get an idea what's possible.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "teams",
                ":username",
                "search",
                "code"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "search_query",
                  "value": "<string>",
                  "description": "(Required) The search query"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Which page of the search results to retrieve"
                },
                {
                  "disabled": false,
                  "key": "pagelen",
                  "value": "10",
                  "description": "How many search results to retrieve per page"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "username",
                  "description": "(Required) The account to search in; either the username or the UUID in curly braces"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "repository repository:write repository:admin repository:delete project project:admin email account account:write team team:write pipeline pipeline:write pipeline:variable runner runner:write test test:write pullrequest pullrequest:write webhook issue issue:write snippet snippet:write wiki"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://bitbucket.org/site/oauth2/access_token"
                },
                {
                  "key": "authUrl",
                  "value": "https://bitbucket.org/site/oauth2/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
